# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# IDE and OS files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Generated benchmark artifacts. Keep empty directories visible in Git.
results/*
!results/.gitkeep
!results/figures/
results/figures/*
!results/figures/.gitkeep
